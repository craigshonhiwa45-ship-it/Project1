{
  "title": "Feedback",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "complaint",
        "suggestion",
        "question"
      ]
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "message": {
      "type": "string",
      "title": "Message"
    }
  },
  "required": [
    "type",
    "subject",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Feedback"
}