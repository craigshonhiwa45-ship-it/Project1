{
  "title": "AppRating",
  "type": "object",
  "properties": {
    "stars": {
      "type": "number",
      "title": "Stars"
    },
    "comment": {
      "type": "string",
      "title": "Comment"
    }
  },
  "required": [
    "stars"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "name": "AppRating"
}