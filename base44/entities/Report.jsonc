{
  "title": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string",
      "title": "Reporter ID"
    },
    "reported_id": {
      "type": "string",
      "title": "Reported ID"
    },
    "conversation_id": {
      "type": "string",
      "title": "Conversation ID"
    },
    "post_id": {
      "type": "string",
      "title": "Post ID",
      "description": "Set when the report is about a feed post"
    },
    "reason": {
      "type": "string",
      "title": "Reason",
      "enum": [
        "harassment",
        "inappropriate content",
        "spam",
        "other"
      ]
    },
    "details": {
      "type": "string",
      "title": "Details"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "open",
        "resolved"
      ]
    }
  },
  "required": [
    "reporter_id",
    "reported_id",
    "reason"
  ],
  "rls": {
    "create": {
      "data.reporter_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Report"
}